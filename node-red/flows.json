    {
        "id": "tpl_catppuccin_css",
        "type": "ui-template",
        "z": "tab_elka_catppuccin",
        "group": "",
        "page": "",
        "ui": "c94615b4ff7ffe30",
        "name": "Catppuccin Mocha Global CSS",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "/* Latar belakang utama Catppuccin Crust -> Mantle */\n.v-main {\n    background: radial-gradient(circle at top, #1e1e2e 0%, #11111b 100%) !important;\n    color: #cdd6f4 !important;\n}\n\n/* Kartu per Sensor (Catppuccin Base & Surface0) */\n.nrdb-ui-group .v-card {\n    background: linear-gradient(145deg, rgba(30, 30, 46, 0.96), rgba(24, 24, 37, 0.96)) !important;\n    border: 1px solid rgba(203, 166, 247, 0.28) !important;\n    border-radius: 16px !important;\n    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.45) !important;\n    padding: 8px !important;\n    color: #cdd6f4 !important;\n}\n\n/* Judul Kartu Sensor (Catppuccin Mauve) */\n.nrdb-ui-group .v-card-title {\n    color: #cba6f7 !important;\n    font-size: 1.02rem !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.6px !important;\n    text-transform: uppercase !important;\n    border-bottom: 1px solid rgba(203, 166, 247, 0.22) !important;\n    padding-bottom: 10px !important;\n    margin-bottom: 10px !important;\n}\n\n/* Header Bar Atas */\n.v-app-bar {\n    background: linear-gradient(90deg, #181825 0%, #313244 100%) !important;\n    border-bottom: 1px solid rgba(203, 166, 247, 0.4) !important;\n    color: #cdd6f4 !important;\n}\n.v-app-bar-title {\n    color: #cba6f7 !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.5px !important;\n}\n\n/* Box Widget Text, Switch & Slider (Catppuccin Surface0) */\n.nrdb-ui-text, .nrdb-ui-switch, .nrdb-ui-slider {\n    background: rgba(49, 50, 68, 0.55) !important;\n    border: 1px solid rgba(180, 190, 254, 0.16) !important;\n    border-radius: 10px !important;\n    padding: 6px 12px !important;\n}\n.nrdb-ui-switch:hover {\n    border-color: rgba(203, 166, 247, 0.6) !important;\n    background: rgba(69, 71, 90, 0.75) !important;\n}\n.nrdb-ui-text-label, .nrdb-ui-switch label, .v-label {\n    color: #bac2de !important;\n    font-weight: 600 !important;\n    font-size: 0.92rem !important;\n    opacity: 1 !important;\n}\n.nrdb-ui-text-value {\n    color: #cdd6f4 !important;\n    font-weight: 800 !important;\n    font-size: 0.98rem !important;\n}\n\n/* Teks angka dalam Gauge */\n.nrdb-ui-gauge text {\n    fill: #cdd6f4 !important;\n    font-weight: 700 !important;\n}",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "site:style",
        "className": "",
        "x": 200,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "mqtt_in_monitoring",
        "type": "mqtt in",
        "z": "tab_elka_catppuccin",
        "name": "Sub Semua Monitoring ESP32",
        "topic": "esp32gacor/monitoring/#",
        "qos": "0",
        "datatype": "utf8",
        "broker": "broker_esp32_elka",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 360,
        "wires": [
            [
                "fn_router_catppuccin"
            ]
        ]
    },
    {
        "id": "fn_router_catppuccin",
        "type": "function",
        "z": "tab_elka_catppuccin",
        "name": "Router Telemetri, Status & Alert",
        "func": "const t = msg.topic;\nconst val = parseFloat(msg.payload);\nif (isNaN(val)) return null;\n\nfunction formatSensorStatus(code) {\n    if (code === 1) return '🟢 ONLINE (Normal)';\n    if (code === 0) return '⚪ STANDBY (Dimatikan)';\n    return '🔴 OFFLINE (Error / Lepas)';\n}\n\n// 16 Outputs:\n// 0: suhu (gauge), 1: hum (gauge), 2: chart_aht (suhu+hum)\n// 3: mq2 (gauge+chart), 4: sonic (gauge+chart)\n// 5: accel_x (gauge), 6: accel_y (gauge), 7: accel_z (gauge), 8: chart_accel\n// 9: stat_aht, 10: stat_mq2, 11: stat_sonic, 12: stat_mma\n// 13: fb_r1, 14: fb_r2, 15: fb_pwm, 16: notif_alert\nlet out = new Array(17).fill(null);\n\nif (t.endsWith('/suhu')) {\n    out[0] = { payload: val };\n    out[2] = { topic: 'Suhu (°C)', payload: val };\n    if (val > 35.0) {\n        out[16] = { topic: '⚠️ PERINGATAN SUHU TINGGI', payload: 'Suhu AHT10 mencapai ' + val.toFixed(1) + ' °C!' };\n    }\n} else if (t.endsWith('/kelembaban')) {\n    out[1] = { payload: val };\n    out[2] = { topic: 'Kelembapan (%RH)', payload: val };\n} else if (t.endsWith('/asap')) {\n    out[3] = { topic: 'Gas MQ-2 (ADC)', payload: val };\n    if (val > 2800) {\n        out[16] = { topic: '🚨 BAHAYA GAS / ASAP', payload: 'Kadar MQ-2 mencapai ' + val + ' ADC!' };\n    }\n} else if (t.endsWith('/jarak')) {\n    out[4] = { topic: 'Jarak (cm)', payload: val };\n} else if (t.endsWith('/accel_x')) {\n    out[5] = { payload: val };\n    out[8] = { topic: 'Sumbu X (g)', payload: val };\n} else if (t.endsWith('/accel_y')) {\n    out[6] = { payload: val };\n    out[8] = { topic: 'Sumbu Y (g)', payload: val };\n} else if (t.endsWith('/accel_z')) {\n    out[7] = { payload: val };\n    out[8] = { topic: 'Sumbu Z (g)', payload: val };\n} else if (t.endsWith('/status_aht')) {\n    out[9] = { payload: formatSensorStatus(val) };\n} else if (t.endsWith('/status_mq2')) {\n    out[10] = { payload: formatSensorStatus(val) };\n} else if (t.endsWith('/status_sonic')) {\n    out[11] = { payload: formatSensorStatus(val) };\n} else if (t.endsWith('/status_mma')) {\n    out[12] = { payload: formatSensorStatus(val) };\n} else if (t.endsWith('/state_relay1')) {\n    out[13] = { payload: val === 1 ? '⚡ MENYALA (HIGH)' : '⭕ MATI (LOW)' };\n} else if (t.endsWith('/state_relay2')) {\n    out[14] = { payload: val === 1 ? '⚡ MENYALA (HIGH)' : '⭕ MATI (LOW)' };\n} else if (t.endsWith('/state_pwm')) {\n    out[15] = { payload: val + ' / 255 (' + Math.round((val / 255) * 100) + '%)' };\n}\n\nreturn out;",
        "outputs": 17,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
